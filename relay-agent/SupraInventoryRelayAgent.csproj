<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>SupraInventoryRelayAgent</RootNamespace>
    <AssemblyName>Agent Auto Confirm Pick Pack</AssemblyName>
    <AssemblyVersion>0.86.0.0</AssemblyVersion>
    <FileVersion>0.86.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore.V1" Version="4.4.0" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" GeneratePathProperty="true" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="EmbedGrpcNativeForCostura" BeforeTargets="FodyTarget">
    <ItemGroup>
      <EmbeddedResource Include="$(PkgGrpc_Core)\runtimes\win-x64\native\grpc_csharp_ext.x64.dll">
        <Link>costura-win-x64\grpc_csharp_ext.x64.dll</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateIcon.ps1&quot; &quot;$(MSBuildProjectDirectory)\app.ico&quot;" />
  </Target>
</Project>
