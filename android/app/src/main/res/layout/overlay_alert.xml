<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8081223"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">
    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_info"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView android:id="@+id/tvOverlayStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/white"
            android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/tvOverlaySku"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center"
            android:textColor="@color/white" android:textSize="27sp"
            android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/tvOverlayProduct"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:gravity="center"
            android:ellipsize="end" android:maxLines="3"
            android:textColor="#EFF8FF" android:textSize="15sp" />
        <ScrollView android:id="@+id/overlayMessageScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:fillViewport="true">
            <TextView android:id="@+id/tvOverlayMessage"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/white"
                android:textSize="16sp" android:lineSpacingExtra="3dp"/>
        </ScrollView>
        <Button android:id="@+id/btnOverlayAck"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="14dp" android:background="@drawable/bg_button_success"
            android:text="ĐÃ HIỂU" android:textColor="@color/white"
            android:textSize="16sp" android:textStyle="bold"
            android:includeFontPadding="false" android:visibility="gone" />
        <TextView android:id="@+id/tvOverlayDismissHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center"
            android:textColor="#D5E7F5" android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
