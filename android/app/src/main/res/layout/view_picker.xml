<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/panelShortage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pickerSkuActionRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/acSkuSearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:completionThreshold="3"
                    android:digits="0123456789"
                    android:hint="Nhập tối thiểu 3 chữ số SKU"
                    android:imeOptions="actionSearch"
                    android:inputType="number"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnReportShortage"
                    android:layout_width="104dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:alpha="0.42"
                    android:background="@drawable/bg_button_danger"
                    android:enabled="false"
                    android:text="Xác nhận"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pickerSelectedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="7dp">

                <TextView
                    android:id="@+id/tvSelectedSku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa chọn SKU"
                    android:textColor="@color/navy_900"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedProduct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:text="Chọn đúng SKU cần báo"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Danh sách SKU đã báo hết hàng"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/listMyReports"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:divider="#DDE3EA"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xác nhận đơn"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nhập đúng 4 số cuối Picklist cần lấy lại. Hệ thống sẽ kiểm tra và xác nhận tự động khi tìm thấy duy nhất một Picklist phù hợp."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etRelayPicklistSuffix"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:digits="0123456789"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:hint="4 số cuối Picklist"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                android:singleLine="true"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnRelayPocSend"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="XÁC NHẬN LẤY LẠI ĐƠN"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRelayPocStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sẵn sàng xác nhận Picklist."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:text="Chỉ xác nhận khi hệ thống tìm thấy duy nhất Picklist khớp đúng 4 số cuối. Trường hợp không rõ ràng sẽ dừng và yêu cầu xử lý trực tiếp."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pickerOperationTabs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="2dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabShortage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_picker_tab_selected"
            android:clickable="true"
            android:contentDescription="Mở nghiệp vụ Báo hết hàng"
            android:focusable="true"
            android:gravity="center"
            android:text="Báo hết hàng"
            android:textColor="@color/navy_900"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabConfirmOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_picker_tab_idle"
            android:clickable="true"
            android:contentDescription="Mở nghiệp vụ Xác nhận đơn"
            android:focusable="true"
            android:gravity="center"
            android:text="Xác nhận đơn"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
