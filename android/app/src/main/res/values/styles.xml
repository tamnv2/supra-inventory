<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.BaoHang.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/navy_900</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.BaoHang.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.BaoHang.Button</item>
        <item name="android:editTextStyle">@style/Widget.BaoHang.EditText</item>
        <item name="android:colorAccent">@color/blue_600</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:navigationBarColor">@color/navy_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
