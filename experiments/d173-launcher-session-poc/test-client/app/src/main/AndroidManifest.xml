<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="vn.supra.pdalauncher.identitytest.permission.SESSION_CONTROL" />
    <queries>
        <package android:name="vn.supra.pdalauncher.identitytest" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="SSO kiểm thử"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".SessionRevokedReceiver"
            android:exported="true"
            android:permission="vn.supra.pdalauncher.identitytest.permission.SESSION_CONTROL">
            <intent-filter>
                <action android:name="vn.supra.identitytest.SESSION_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
